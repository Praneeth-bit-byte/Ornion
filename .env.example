# ============================================================================
# ORNION — Personal AI Assistant Environment Configuration
# Created and developed by Praneeth Thota
# Copy this file to .env and fill in your actual credentials.
# Never commit .env or real API keys to Git.
# ============================================================================

# NVIDIA API Catalog (OpenAI-Compatible Chat Completions API)
# Get your API key at: https://build.nvidia.com/
NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY"
NVIDIA_MODEL="mistralai/mistral-large-4-1t-a52b"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_TIMEOUT_MS="25000"

# APP_URL: Local or hosted application URL
APP_URL="http://localhost:3000"
